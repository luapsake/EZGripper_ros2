<?xml version="1.0"?>

<robot name="ezgripper_triple_with_mount" xmlns:xacro="http://ros.org/wiki/xacro">


  <xacro:macro name="ezgripper_triple_with_mount" params="prefix parent_link *origin">
    <!-- Use the robot prefix for consistent naming across all components -->
    
    <!-- Define gripper spacing properties -->
    <xacro:property name="gripper_spacing" value="0.068"/>  <!-- Gripper separation in m (6.8cm) -->
    <xacro:property name="gripper_offset" value="0.01254"/>   <!-- Gripper offset in the positive X direction from the mount in m (1.254cm) -->

    <!-- Include the gripper and mount files -->
    <xacro:include filename="$(find ezgripper_description)/urdf/SAKE_triple_mount.urdf.xacro" />
    <xacro:include filename="$(find ezgripper_description)/urdf/ezgripper_single.urdf.xacro" />

    <!-- Instantiate the triple mount as a common component for all grippers -->
    <xacro:SAKE_triple_mount prefix="${prefix}" parent_link="${parent_link}">
      <xacro:insert_block name="origin"/>
    </xacro:SAKE_triple_mount>
    
    <!-- Instantiate the first ezgripper (left position) with unique prefix -->
    <!-- Each gripper in the triple assembly has a unique prefix to ensure proper naming -->
    <xacro:ezgripper_single prefix="${prefix}_1" parent_link="${prefix}_ezgripper_to_mount">
      <origin xyz="${gripper_offset} 0 ${gripper_spacing}" rpy="0 0 0"/>
    </xacro:ezgripper_single>

    <!-- Instantiate the second ezgripper (center position) with unique prefix -->
    <xacro:ezgripper_single prefix="${prefix}_2" parent_link="${prefix}_ezgripper_to_mount">
      <origin xyz="${gripper_offset} 0 0" rpy="0 0 0"/>
    </xacro:ezgripper_single>

    <!-- Instantiate the third ezgripper (right position) with unique prefix -->
    <xacro:ezgripper_single prefix="${prefix}_3" parent_link="${prefix}_ezgripper_to_mount">
      <origin xyz="${gripper_offset} 0 -${gripper_spacing}" rpy="0 0 0"/>
    </xacro:ezgripper_single>

  </xacro:macro>


</robot>
