<?xml version="1.0" encoding="UTF-8"?>
<robot name="ezgripper_single_mount" xmlns:xacro="http://ros.org/wiki/xacro">


	<xacro:property name="ezgripper_offset_x" value="0.02"/>
	<xacro:property name="ezgripper_offset_y" value="0.0"/>
	<xacro:property name="ezgripper_offset_z" value="0.3"/>

	<xacro:include filename="$(find ezgripper_description)/urdf/materials.urdf.xacro"/>
	<!-- Define materials -->
	<xacro:define_ezgripper_materials />
	<xacro:include filename="$(find ezgripper_description)/urdf/ezgripper_single.urdf.xacro"/>
	<xacro:include filename="$(find ezgripper_description)/urdf/ezgripper_single_mount.urdf.xacro"/>

	<!-- Robot prefix parameter for consistent naming across all components -->
	<xacro:arg name="prefix" default="ezgripper_1"/>
	<!-- Define the prefix property to ensure it's accessible in all included files -->
	<xacro:property name="prefix" value="$(arg prefix)"/>


	<!-- Add the gripper -->
	<xacro:ezgripper_single_mount prefix="$(arg prefix)" parent_link="base_link">
		<origin xyz="${ezgripper_offset_x} ${ezgripper_offset_y} ${ezgripper_offset_z}" rpy="0 0 0"/>
	</xacro:ezgripper_single_mount>

	<link name="world"/>

	<joint name="fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
	</joint>

	<link name="base_link">
		<visual>
			<geometry>
				<cylinder length="0.42" radius="0.02"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0.21"/>
			<material name="ezgripper_black"/>
		</visual>
		<collision>
			<geometry>
				<cylinder length="0.42" radius="0.02"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0.21"/>
		</collision>
	</link>

	<gazebo reference="base_link">
		<material>Gazebo/Black</material>
	</gazebo>

</robot>
